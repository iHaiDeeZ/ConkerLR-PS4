diff --git a/CMakeLists.txt b/CMakeLists.txt
index 37cbe88..04ea9a3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,6 +9,17 @@ cmake_minimum_required(VERSION 3.20)
 
 project(clx_recomp C)
 
+# PS4 (OpenOrbis, built with ps4-kit: scripts/build-clx.sh in the ConkerLR repo). The Vulkan
+# renderer on the kit's RADV, the DualShock 4 through scePad, SDL2 only for the sound output.
+option(CLX_PS4 "Build for the PS4 with ps4-kit" OFF)
+if(CLX_PS4)
+    enable_language(CXX ASM)
+    set(PS4_KIT_NETFS OFF CACHE BOOL "" FORCE)
+    include($ENV{HOME}/ps4-kit/ps4-kit.cmake)
+    set(NFSU2_VULKAN ON CACHE BOOL "" FORCE)
+    add_compile_definitions(XBOXRECOMP_MMIO_ACCESSORS=1)
+endif()
+
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED ON)
 
@@ -54,6 +65,9 @@ set(GAME_SOURCES
     src/clx_menu.c
     src/clx_buttons.c
 )
+if(CLX_PS4)
+    list(APPEND GAME_SOURCES src/ps4_clx.c)
+endif()
 
 if(MSVC)
     add_executable(${PROJECT_NAME} WIN32 ${GAME_SOURCES} ${RECOMP_GEN_SOURCES})
@@ -113,7 +127,7 @@ if(NOT MSVC)
     # The generated chunks are huge straight-line functions; -O1 keeps GCC's
     # memory and time per chunk sane while still allocating registers. The
     # Switch's CPU is the bottleneck there, so it gets -O2.
-    if(NINTENDO_SWITCH)
+    if(NINTENDO_SWITCH OR CLX_PS4)
         set(NFSU2_GEN_OPT "-O2" CACHE STRING "Optimisation for the lifted code")
     else()
         set(NFSU2_GEN_OPT "-O1" CACHE STRING "Optimisation for the lifted code")
@@ -137,6 +151,25 @@ if(NOT MSVC)
     target_link_libraries(${PROJECT_NAME} PRIVATE m)
 endif()
 
+# ── PS4 (ps4-kit) ───────────────────────────────────────────────
+#
+# The disc goes into the package (/app0/game); saves, caches and logs live in
+# /data/ConkerLR (src/ps4_clx.c).
+if(CLX_PS4)
+    set(CLX_PS4_VERSION "00.00" CACHE STRING "Version written to the log")
+    set_property(SOURCE src/ps4_clx.c APPEND PROPERTY
+        COMPILE_DEFINITIONS "CLX_VERSION=\"${CLX_PS4_VERSION}\"")
+    target_link_libraries(${PROJECT_NAME} PRIVATE -lScePad -lSceUserService -lSceAudioOut
+        -lSceSystemService -lSceVideoOut)
+    # ps4-kit's DNS wrap calls __real_getaddrinfo, and a __real_ reference never pulls the C
+    # library's member in (kit apps with the /net shares get it through libsmb2): ask for it.
+    target_link_options(${PROJECT_NAME} PRIVATE --undefined=getaddrinfo)
+    # SDL's audio thread priority (src/ps4_clx.c)
+    target_link_options(${PROJECT_NAME} PRIVATE --wrap=SDL_SYS_SetThreadPriority)
+    ps4_kit_link_mesa(${PROJECT_NAME})
+    ps4_kit_app(${PROJECT_NAME})
+endif()
+
