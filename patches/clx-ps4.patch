+/* Virtual memory on the PS4, after the Horizon design above.
+ *
+ *   MEM_RESERVE         address space only (sceKernelReserveVirtualRange).
+ *                       The first reservation is widened to 4 GB + 64 KB, so
+ *                       every guest aperture lands at base + VA: "the window".
+ *   MEM_COMMIT at addr  direct memory mapped there with MAP_FIXED. The PS4's
+ *                       pages are 16 KB, the Xbox's 4 KB, so commits widen to
+ *                       whole host pages, and a host page that is already
+ *                       backed (a view, an earlier commit) is left as it is.
+ *   MEM_COMMIT, no addr the heap, page aligned and zeroed.
+ *   file mapping        a block of direct memory; every view maps it again,
+ *                       so the RAM mirrors and the tiled aperture alias it as
+ *                       on the console.
+ *
+ * Protection changes are accepted and ignored, as on Horizon: nothing on this
+ * host traps guest faults (MMIO goes through accessors). */
+#define PS4_PAGE        0x4000u
+#define PS4_MAP_FIXED   0x10
+#define PS4_PROT_CPU_RW 0x03
+int    sceKernelReserveVirtualRange(void **addr, size_t len, int flags, size_t align);
+int    sceKernelMapDirectMemory(void **addr, size_t len, int prot, int flags, off_t phys, size_t align);
+int    sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t align, int type, off_t *phys);
+int    sceKernelReleaseDirectMemory(off_t start, size_t len);
+size_t sceKernelGetDirectMemorySize(void);
+int    sceKernelMunmap(void *addr, size_t len);
+
+typedef struct {
+    uintptr_t addr;
+    size_t    len;
+    off_t     phys;         /* direct memory behind it; -1 for heap */
+    int       owns_phys;    /* a commit (release the memory) or a view (the mapping owns it) */
+    int       heap;
+} ps4_region;
+
+#define PS4_MAX_REGIONS 512
+static ps4_region      s_ps4[PS4_MAX_REGIONS];
+static pthread_mutex_t s_ps4_lock = PTHREAD_MUTEX_INITIALIZER;
+static uintptr_t       s_ps4_win;           /* the first reservation */
+static size_t          s_ps4_win_len;
+static uint8_t        *s_ps4_backed;        /* one bit per host page of the window */
+
+static size_t ps4_page(size_t n) { return (n + PS4_PAGE - 1) & ~(size_t)(PS4_PAGE - 1); }
+
+static int ps4_in_win(uintptr_t a, size_t len)
+{
+    return s_ps4_backed && a >= s_ps4_win && a + len <= s_ps4_win + s_ps4_win_len;
+}
+
+static int ps4_backed(uintptr_t a)
+{
+    size_t i = (a - s_ps4_win) / PS4_PAGE;
+    return (s_ps4_backed[i >> 3] >> (i & 7)) & 1;
+}
+
+static void ps4_mark(uintptr_t a, size_t len, int on)
+{
+    size_t i = (a - s_ps4_win) / PS4_PAGE, n = len / PS4_PAGE;
+    for (; n; i++, n--) {
+        if (on) s_ps4_backed[i >> 3] |= (uint8_t)(1u << (i & 7));
+        else    s_ps4_backed[i >> 3] &= (uint8_t)~(1u << (i & 7));
+    }
+}
+
+static ps4_region *ps4_add(uintptr_t addr, size_t len, off_t phys, int owns, int heap)
+{
+    int i;
+    for (i = 0; i < PS4_MAX_REGIONS; i++)
+        if (!s_ps4[i].len) {
+            s_ps4[i].addr = addr; s_ps4[i].len = len; s_ps4[i].phys = phys;
+            s_ps4[i].owns_phys = owns; s_ps4[i].heap = heap;
+            return &s_ps4[i];
+        }
+    fprintf(stderr, "  [PS4] out of memory region slots (%d)\n", PS4_MAX_REGIONS);
+    return NULL;
+}
+
+static ps4_region *ps4_find(uintptr_t addr)
+{
+    int i;
+    for (i = 0; i < PS4_MAX_REGIONS; i++)
+        if (s_ps4[i].len && addr >= s_ps4[i].addr && addr < s_ps4[i].addr + s_ps4[i].len)
+            return &s_ps4[i];
+    return NULL;
+}
+
+static off_t ps4_alloc_direct(size_t len)
+{
+    off_t phys = 0;
+    int rc = sceKernelAllocateDirectMemory(0, (off_t)sceKernelGetDirectMemorySize(), len,
+                                           PS4_PAGE, 0, &phys);
+    if (rc) {
+        fprintf(stderr, "  [PS4] %zu KB of direct memory not available (0x%x)\n", len / 1024, rc);
+        return -1;
+    }
+    return phys;
+}
+
+static int ps4_map_phys(uintptr_t at, size_t len, off_t phys)
+{
+    void *a = (void *)at;
+    int rc = sceKernelMapDirectMemory(&a, len, PS4_PROT_CPU_RW, PS4_MAP_FIXED, phys, PS4_PAGE);
+    if (rc || a != (void *)at) {
+        fprintf(stderr, "  [PS4] mapping %zu KB at %p failed (0x%x)\n", len / 1024, (void *)at, rc);
+        return 0;
+    }
+    return 1;
+}
+
+/* Give a range back to the window's reservation after its mapping goes. */
+static void ps4_unmap(uintptr_t at, size_t len)
+{
+    void *a = (void *)at;
+    sceKernelMunmap(a, len);
+    if (ps4_in_win(at, len)) {
+        sceKernelReserveVirtualRange(&a, len, PS4_MAP_FIXED, 0);
+        ps4_mark(at, len, 0);
+    }
+}
+
+/* Fresh zeroed memory for every host page of [a, a+len) not backed yet, one
+ * direct-memory block per run. a and len are host-page aligned. */
+static int ps4_commit(uintptr_t a, size_t len)
+{
+    uintptr_t p = a, end = a + len, run;
+    while (p < end) {
+        off_t phys;
+        if (ps4_backed(p)) {
+            p += PS4_PAGE;
+            continue;
+        }
+        for (run = p; run < end && !ps4_backed(run); run += PS4_PAGE)
+            ;
+        phys = ps4_alloc_direct(run - p);
+        if (phys < 0)
+            return 0;
+        if (!ps4_map_phys(p, run - p, phys)) {
+            sceKernelReleaseDirectMemory(phys, run - p);
+            return 0;
+        }
+        memset((void *)p, 0, run - p);
+        ps4_mark(p, run - p, 1);
+        ps4_add(p, run - p, phys, 1, 0);
+        p = run;
+    }
+    return 1;
+}
+
+LPVOID VirtualAlloc(LPVOID address, SIZE_T size, DWORD allocationType, DWORD protect)
+{
+    (void)protect;
+    if (!size) { SetLastError(ERROR_INVALID_PARAMETER); return NULL; }
+    pthread_mutex_lock(&s_ps4_lock);
+
+    if (!address && !(allocationType & MEM_COMMIT)) {           /* reserve */
+        size_t want = ps4_page(size);
+        void *at = NULL;
+        int first = !s_ps4_win, rc;
+        if (first && want < 0x100010000ull)
+            want = 0x100010000ull;
+        rc = sceKernelReserveVirtualRange(&at, want, 0, 2u << 20);
+        if (rc) {
+            pthread_mutex_unlock(&s_ps4_lock);
+            fprintf(stderr, "  [PS4] reserving %zu MB failed (0x%x)\n", want >> 20, rc);
+            SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+            return NULL;
+        }
+        if (first) {
+            s_ps4_backed = calloc(want / PS4_PAGE / 8 + 1, 1);
+            s_ps4_win = (uintptr_t)at;
+            s_ps4_win_len = want;
+        }
+        pthread_mutex_unlock(&s_ps4_lock);
+        fprintf(stderr, "  [PS4] reserved %zu MB at %p\n", want >> 20, at);
+        return at;
+    }
+
+    if (!address) {                                             /* heap */
+        size_t len = ps4_page(size);
+        void *p = memalign(PS4_PAGE, len);
+        if (p) {
+            memset(p, 0, len);
+            ps4_add((uintptr_t)p, len, -1, 0, 1);
+            view_register(p, len);
+        }
+        pthread_mutex_unlock(&s_ps4_lock);
+        if (!p) SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return p;
+    }
+
+    if (!(allocationType & MEM_COMMIT)) {                       /* reserve at addr */
+        int ok = ps4_in_win((uintptr_t)address, size);
+        pthread_mutex_unlock(&s_ps4_lock);
+        if (!ok) { SetLastError(ERROR_INVALID_ADDRESS); return NULL; }
+        return address;         /* inside our own reservation: nothing to do */
+    }
+
+    {                                                           /* commit at addr */
+        uintptr_t a = (uintptr_t)address & ~(uintptr_t)(PS4_PAGE - 1);
+        size_t len = ps4_page((uintptr_t)address + size - a);
+        if (!ps4_in_win(a, len)) {
+            pthread_mutex_unlock(&s_ps4_lock);
+            fprintf(stderr, "  [PS4] commit at %p (+%zu KB) is outside the guest window\n",
+                    address, (size_t)size / 1024);
+            SetLastError(ERROR_INVALID_ADDRESS);
+            return NULL;
+        }
+        if (!ps4_commit(a, len)) {
+            pthread_mutex_unlock(&s_ps4_lock);
+            SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+            return NULL;
+        }
+        view_register(address, size);
+        pthread_mutex_unlock(&s_ps4_lock);
+        return address;
+    }
+}
+
+BOOL VirtualFree(LPVOID address, SIZE_T size, DWORD freeType)
+{
+    ps4_region *r;
+    (void)size;
+
+    if (!(freeType & MEM_RELEASE))
+        return TRUE;                              /* decommit: keep it */
+    pthread_mutex_lock(&s_ps4_lock);
+    view_take(address);
+    r = ps4_find((uintptr_t)address);
+    if (r && r->addr == (uintptr_t)address) {
+        if (r->heap) {
+            free((void *)r->addr);
+        } else {
+            ps4_unmap(r->addr, r->len);
+            if (r->owns_phys)
+                sceKernelReleaseDirectMemory(r->phys, r->len);
+        }
+        memset(r, 0, sizeof *r);
+    }
+    /* Releasing a slice of the reservation (to map a view into it) is a no-op:
+     * the view maps over the reserved range. */
+    pthread_mutex_unlock(&s_ps4_lock);
+    return TRUE;
+}
