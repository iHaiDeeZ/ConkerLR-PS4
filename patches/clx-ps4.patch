index 0000000..00b4332
--- /dev/null
+++ b/xboxrecomp/src/nv2a_vk/ps4_post.h
@@ -0,0 +1,610 @@
+/* ps4_post.h -- the PS4's picture passes, included by nv2a_vk.c (before
+ * vk_flip, which calls post_present). Set at run time by the port's quick menu:
+ *
+ *   nv2a_vk_display   0 fit: the picture at its own aspect, black bars
+ *                     1 stretch: the whole screen
+ *                     (2 wide: the game's Hor+ 16:9, xbox_widescreen)
+ *   nv2a_vk_upscale   0 bilinear (the FXAA pass scales it), 1 FSR 1: FXAA (if on)
+ *                     at the render size, EASU to the size shown, RCAS sharpening
+ *   nv2a_vk_framegen  frame generation: every frame also makes an in-between
+ *                     frame from the motion since the frame before (shaders/fg.comp,
+ *                     DawnStation's v3), presented a vblank ahead of it: a game at
+ *                     30 fps is shown at 60. Off with the game at 60.
+ *
+ * With frame generation each frame is drawn into s_out[] (R8G8B8A8, the
+ * screen's size) instead of the swapchain image; the passes read the last two,
+ * write the in-between one into s_mid, and both are blitted into two swapchain
+ * images presented one after the other (the kit's swapchain queues every
+ * flip at a vblank, mailbox included). */
+
+#include "fsr_easu_spv.h"
+#include "fsr_rcas_spv.h"
+#include "fg_luma_spv.h"
+#include "fg_proj_spv.h"
+#include "fg_global_spv.h"
+#include "fg_motion_spv.h"
+#include "fg_select_spv.h"
+#include "fg_interp_spv.h"
+
+volatile int nv2a_vk_display;
+volatile int nv2a_vk_upscale;
+volatile int nv2a_vk_framegen;
+
+#define POST_FMT VK_FORMAT_R8G8B8A8_UNORM
+#define FSR_SHARPNESS 0.25f                 /* RCAS: stops below the most */
+#define FG_GN (2 * 63 + 1 + 2 * 31 + 1)    /* fg.comp's GLOBAL costs */
+
+typedef struct {
+    VkImage image;
+    VkImageView view;
+    VkDeviceMemory mem;
+    uint32_t w, h;
+} PostImg;
+
+typedef struct {
+    VkBuffer buf;
+    VkDeviceMemory mem;
+    VkDeviceSize size;
+} PostBuf;
+
+enum { FB_LUMA0, FB_LUMA1, FB_PROJ0, FB_PROJ1, FB_COSTS, FB_VEC0, FB_VEC1, FB_PICKS, FB_COUNT, FB_N };
+enum { FG_LUMA, FG_PROJ, FG_GLOBAL, FG_MOTION, FG_SELECT, FG_INTERP, FG_N };
+
+static int s_post_state;                    /* 0 not tried, 1 ready, -1 failed */
+static VkShaderModule s_post_vs;
+static VkPipelineLayout s_easu_layout, s_rcas_layout;
+static VkPipeline s_easu_pipe;
+static struct { VkFormat fmt; VkPipeline pipe; } s_rcas[2];
+static PostImg s_aa, s_up, s_out[2], s_mid;
+
+static VkDescriptorSetLayout s_fg_dsl;
+static VkPipelineLayout s_fg_layout;
+static VkPipeline s_fg_pipe[FG_N];
+static PostBuf s_fgb[FB_N];
+static uint32_t s_fg_w, s_fg_h;
+static int s_fg_cur;                        /* s_out[] holding the newest frame */
+static int s_fg_have;                       /* frames in s_out[]: 0, 1 or 2 */
+static int s_fg_state;                      /* 0 not tried, 1 ready, -1 failed */
+static int s_idx2 = -1;                     /* the second swapchain image of this flip */
+
+static uint32_t fbits(float f)
+{
+    union { float f; uint32_t u; } x;
+    x.f = f;
+    return x.u;
+}
+
+static VkShaderModule post_module(const uint32_t *code, size_t bytes)
+{
+    VkShaderModuleCreateInfo ci = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    VkShaderModule m = VK_NULL_HANDLE;
+    ci.codeSize = bytes;
+    ci.pCode = code;
+    if (vkCreateShaderModule(s_dev, &ci, NULL, &m) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    return m;
+}
+
+static VkPipeline post_gfx_pipe(const uint32_t *code, size_t bytes, VkFormat fmt, VkPipelineLayout layout)
+{
+    VkGraphicsPipelineCreateInfo ci = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    VkPipelineShaderStageCreateInfo st[2];
+    VkPipelineVertexInputStateCreateInfo vi = { VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+    VkPipelineViewportStateCreateInfo vp = { VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+    VkPipelineRasterizationStateCreateInfo rs = { VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+    VkPipelineMultisampleStateCreateInfo ms = { VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+    VkPipelineColorBlendAttachmentState ba;
+    VkPipelineColorBlendStateCreateInfo cb = { VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+    VkPipelineDynamicStateCreateInfo dy = { VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+    VkPipelineRenderingCreateInfo rci = { VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO };
+    static const VkDynamicState dyn[] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkShaderModule fs = post_module(code, bytes);
+    VkPipeline pipe = VK_NULL_HANDLE;
+
+    if (!fs)
+        return VK_NULL_HANDLE;
+    memset(st, 0, sizeof st);
+    st[0].sType = st[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    st[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    st[0].module = s_post_vs;
+    st[0].pName = "main";
+    st[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    st[1].module = fs;
+    st[1].pName = "main";
+    ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    vp.viewportCount = vp.scissorCount = 1;
+    rs.polygonMode = VK_POLYGON_MODE_FILL;
+    rs.lineWidth = 1.0f;
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    memset(&ba, 0, sizeof ba);
+    ba.colorWriteMask = 0xF;
+    cb.attachmentCount = 1;
+    cb.pAttachments = &ba;
+    dy.dynamicStateCount = 2;
+    dy.pDynamicStates = dyn;
+    rci.colorAttachmentCount = 1;
+    rci.pColorAttachmentFormats = &fmt;
+    ci.pNext = &rci;
+    ci.stageCount = 2;
+    ci.pStages = st;
+    ci.pVertexInputState = &vi;
+    ci.pInputAssemblyState = &ia;
+    ci.pViewportState = &vp;
+    ci.pRasterizationState = &rs;
+    ci.pMultisampleState = &ms;
+    ci.pColorBlendState = &cb;
+    ci.pDynamicState = &dy;
+    ci.layout = layout;
+    if (vkCreateGraphicsPipelines(s_dev, s_pcache, 1, &ci, NULL, &pipe) != VK_SUCCESS)
+        pipe = VK_NULL_HANDLE;
+    vkDestroyShaderModule(s_dev, fs, NULL);
+    return pipe;
+}
+
+static VkPipelineLayout post_layout(VkDescriptorSetLayout dsl, VkShaderStageFlags stage, uint32_t pc_bytes)
+{
+    VkPushConstantRange pr = { stage, 0, pc_bytes };
+    VkPipelineLayoutCreateInfo pli = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    VkPipelineLayout l = VK_NULL_HANDLE;
+    pli.setLayoutCount = 1;
+    pli.pSetLayouts = &dsl;
+    pli.pushConstantRangeCount = 1;
+    pli.pPushConstantRanges = &pr;
+    if (vkCreatePipelineLayout(s_dev, &pli, NULL, &l) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    return l;
+}
+
+/* FSR's pipelines (after pp_pipe made the FXAA pass's set layout and sampler). */
+static int post_init(void)
+{
+    if (s_post_state)
+        return s_post_state > 0;
+    s_post_state = -1;
+    if (!pp_pipe(POST_FMT) || !s_pp_dsl)
+        return 0;
+    s_post_vs = compile(GLSLANG_STAGE_VERTEX, s_pp_vs);
+    s_easu_layout = post_layout(s_pp_dsl, VK_SHADER_STAGE_FRAGMENT_BIT, 64);
+    s_rcas_layout = post_layout(s_pp_dsl, VK_SHADER_STAGE_FRAGMENT_BIT, 48);
+    if (!s_post_vs || !s_easu_layout || !s_rcas_layout)
+        return 0;
+    s_easu_pipe = post_gfx_pipe(fsr_easu_spv, sizeof fsr_easu_spv, POST_FMT, s_easu_layout);
+    if (!s_easu_pipe) {
+        LOGE("FSR: EASU pipeline failed; upscaling stays bilinear\n");
+        return 0;
+    }
+    s_post_state = 1;
+    fprintf(stderr, "  [VK] FSR 1 ready\n");
+    return 1;
+}
+
+static VkPipeline rcas_pipe(VkFormat fmt)
+{
+    int i;
+    for (i = 0; i < 2; i++)
+        if (s_rcas[i].pipe && s_rcas[i].fmt == fmt)
+            return s_rcas[i].pipe;
+    i = s_rcas[0].pipe ? 1 : 0;
+    if (s_rcas[i].pipe)
+        return VK_NULL_HANDLE;              /* a third format: never */
+    s_rcas[i].pipe = post_gfx_pipe(fsr_rcas_spv, sizeof fsr_rcas_spv, fmt, s_rcas_layout);
+    s_rcas[i].fmt = fmt;
+    return s_rcas[i].pipe;
+}
+
+/* An image of ours at w x h, made again when the size changes (left GENERAL). */
+static int post_img(PostImg *p, uint32_t w, uint32_t h, VkImageUsageFlags usage)
+{
+    if (p->image && p->w == w && p->h == h)
+        return 1;
+    if (p->image)
+        garbage_add(p->image, p->view, p->mem);
+    memset(p, 0, sizeof *p);
+    if (!make_image(w, h, POST_FMT, usage, VK_IMAGE_ASPECT_COLOR_BIT, &p->image, &p->view, &p->mem)) {
+        memset(p, 0, sizeof *p);
+        return 0;
+    }
+    p->w = w;
+    p->h = h;
+    return 1;
+}
+
+static void post_barrier(VkPipelineStageFlags src, VkAccessFlags src_access,
+                         VkPipelineStageFlags dst, VkAccessFlags dst_access)
+{
+    VkMemoryBarrier mb = { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    mb.srcAccessMask = src_access;
+    mb.dstAccessMask = dst_access;
+    vkCmdPipelineBarrier(s_cb, src, dst, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static void swapchain_layout(VkImage img, VkImageLayout from, VkImageLayout to, VkAccessFlags src_access,
+                             VkAccessFlags dst_access, VkPipelineStageFlags src, VkPipelineStageFlags dst)
+{
+    VkImageMemoryBarrier b = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    b.srcAccessMask = src_access;
+    b.dstAccessMask = dst_access;
+    b.oldLayout = from;
+    b.newLayout = to;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = img;
+    b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    b.subresourceRange.levelCount = 1;
+    b.subresourceRange.layerCount = 1;
+    vkCmdPipelineBarrier(s_cb, src, dst, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+/* One full-screen-triangle pass into `area` of the target (all of it cleared to
+ * black first). A swapchain image (target_img set) goes from UNDEFINED and ends
+ * in `final`; one of ours stays GENERAL. */
+static void post_pass(VkImageView target, VkImage target_img, VkExtent2D ext, VkRect2D area,
+                      VkPipeline pipe, VkPipelineLayout layout, VkImageView in0, VkImageView in1,
+                      const void *pc, uint32_t pc_bytes, int osd, VkImageLayout final)
+{
+    VkRenderingAttachmentInfo ca = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+    VkRenderingInfo ri = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+    VkViewport vp = { (float)area.offset.x, (float)area.offset.y, (float)area.extent.width,
+                      (float)area.extent.height, 0.0f, 1.0f };
+    VkDescriptorImageInfo ii[2];
+    VkWriteDescriptorSet wr[2] = { { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET },
+                                   { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET } };
+
+    end_rendering();
+    if (target_img)
+        swapchain_layout(target_img, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, 0,
+                         VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                         VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT);
+    else
+        post_barrier(VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+                     VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT,
+                     VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
+    ca.imageView = target;
+    ca.imageLayout = target_img ? VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL : VK_IMAGE_LAYOUT_GENERAL;
+    ca.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    ca.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    ca.clearValue.color.float32[3] = 1.0f;
+    ri.renderArea.extent = ext;
+    ri.layerCount = 1;
+    ri.colorAttachmentCount = 1;
+    ri.pColorAttachments = &ca;
+    p_begin_rendering(s_cb, &ri);
+    vkCmdBindPipeline(s_cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+    vkCmdSetViewport(s_cb, 0, 1, &vp);
+    vkCmdSetScissor(s_cb, 0, 1, &area);
+    ii[0].sampler = ii[1].sampler = s_pp_sampler;
+    ii[0].imageView = in0;
+    ii[1].imageView = in1 ? in1 : s_dummy_view;
+    ii[0].imageLayout = ii[1].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    wr[0].dstBinding = 0;
+    wr[0].descriptorCount = 1;
+    wr[0].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    wr[0].pImageInfo = &ii[0];
+    wr[1] = wr[0];
+    wr[1].dstBinding = 1;
+    wr[1].pImageInfo = &ii[1];
+    p_push_desc(s_cb, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, 2, wr);
+    s_desc_cb_gen = 0;                      /* s_layout's pushed set is disturbed */
+    vkCmdPushConstants(s_cb, layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, pc_bytes, pc);
+    vkCmdDraw(s_cb, 3, 1, 0, 0);
+    if (osd)
+        osd_fps(ext);
+    p_end_rendering(s_cb);
+    if (target_img)
+        swapchain_layout(target_img, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, final,
+                         VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, 0, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                         VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    else
+        post_barrier(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                     VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+                     VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT);
+    s_dyn_valid = 0;
+}
+
+/* Surface s with FSR 1 into the rectangle (dx, dy, dw, dh) of the target (a
+ * swapchain image when dst_img is set, else one of ours). 0 = not recorded. */
+static int post_fsr(VkSurf *s, VkImage dst_img, VkImageView dview, VkFormat fmt, VkExtent2D ext,
+                    int dx, int dy, int dw, int dh, int osd)
+{
+    VkImageView in = s->view, ov;
+    VkPipeline rcas;
+    float iw = (float)s->pw, ih = (float)s->ph, ow = (float)dw, oh = (float)dh;
+    uint32_t easu[16];
+    struct { uint32_t con[4]; float rect[4]; float flags[4]; } rc;
+    VkRect2D up_area = { { 0, 0 }, { (uint32_t)dw, (uint32_t)dh } };
+    VkRect2D area = { { dx, dy }, { (uint32_t)dw, (uint32_t)dh } };
+    VkExtent2D up_ext = { (uint32_t)dw, (uint32_t)dh };
+
+    if (!post_init() || !(rcas = rcas_pipe(fmt)))
+        return 0;
+    if (!post_img(&s_up, (uint32_t)dw, (uint32_t)dh,
+                  VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT))
+        return 0;
+    /* FXAA first, at the render size: EASU then keeps its smoothed edges. */
+    if (fxaa_on() && nv2a_vk_fxaa &&
+        post_img(&s_aa, s->pw, s->ph, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT)) {
+        VkExtent2D aa_ext = { s->pw, s->ph };
+        s_pp_bare = 1;
+        if (present_fxaa(s, s_aa.image, s_aa.view, POST_FMT, aa_ext, 0, 0, (int)s->pw, (int)s->ph,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT))
+            in = s_aa.view;
+        s_pp_bare = 0;
+    }
+    /* FsrEasuCon, the input's viewport its whole size */
+    easu[0] = fbits(iw / ow);
+    easu[1] = fbits(ih / oh);
+    easu[2] = fbits(0.5f * iw / ow - 0.5f);
+    easu[3] = fbits(0.5f * ih / oh - 0.5f);
+    easu[4] = fbits(1.0f / iw);
+    easu[5] = fbits(1.0f / ih);
+    easu[6] = fbits(1.0f / iw);
+    easu[7] = fbits(-1.0f / ih);
+    easu[8] = fbits(-1.0f / iw);
+    easu[9] = fbits(2.0f / ih);
+    easu[10] = fbits(1.0f / iw);
+    easu[11] = fbits(2.0f / ih);
+    easu[12] = fbits(0.0f);
+    easu[13] = fbits(4.0f / ih);
+    easu[14] = easu[15] = 0;
+    post_pass(s_up.view, VK_NULL_HANDLE, up_ext, up_area, s_easu_pipe, s_easu_layout, in, VK_NULL_HANDLE,
+              easu, sizeof easu, 0, VK_IMAGE_LAYOUT_GENERAL);
+    /* FsrRcasCon (the 32-bit path reads con.x only), and the overlay */
+    ov = ovl_view();
+    memset(&rc, 0, sizeof rc);
+    rc.con[0] = fbits(exp2f(-FSR_SHARPNESS));
+    rc.rect[0] = (float)dx; rc.rect[1] = (float)dy; rc.rect[2] = ow; rc.rect[3] = oh;
+    rc.flags[0] = ov ? 1.0f : 0.0f;
+    post_pass(dview, dst_img, ext, area, rcas, s_rcas_layout, s_up.view, ov, &rc, sizeof rc, osd,
+              VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+    return 1;
+}
+
+/* ── Frame generation ─────────────────────────────────────────────── */
+
+static int post_buf(PostBuf *b, VkDeviceSize size)
+{
+    VkBufferCreateInfo bci = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    VkMemoryRequirements rq;
+    bci.size = size;
+    bci.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    if (vkCreateBuffer(s_dev, &bci, NULL, &b->buf) != VK_SUCCESS)
+        return 0;
+    vkGetBufferMemoryRequirements(s_dev, b->buf, &rq);
+    b->mem = alloc_mem(rq, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (!b->mem || vkBindBufferMemory(s_dev, b->buf, b->mem, 0) != VK_SUCCESS)
+        return 0;
+    b->size = size;
+    vkCmdFillBuffer(s_cb, b->buf, 0, VK_WHOLE_SIZE, 0);
+    return 1;
+}
+
+static int fg_init(uint32_t w, uint32_t h)
+{
+    static const struct { const uint32_t *code; size_t bytes; } k[FG_N] = {
+        { fg_luma_spv, sizeof fg_luma_spv }, { fg_proj_spv, sizeof fg_proj_spv },
+        { fg_global_spv, sizeof fg_global_spv }, { fg_motion_spv, sizeof fg_motion_spv },
+        { fg_select_spv, sizeof fg_select_spv }, { fg_interp_spv, sizeof fg_interp_spv },
+    };
+    uint32_t lw = (w + 3) / 4, lh = (h + 3) / 4, bw = (lw + 3) / 4, bh = (lh + 3) / 4;
+    VkDeviceSize sizes[FB_N];
+    int i;
+
+    if (s_fg_state && (s_fg_state < 0 || (s_fg_w == w && s_fg_h == h)))
+        return s_fg_state > 0;
+    if (s_fg_state > 0) {                   /* another screen size: buffers again */
+        vkDeviceWaitIdle(s_dev);
+        for (i = 0; i < FB_N; i++) {
+            vkDestroyBuffer(s_dev, s_fgb[i].buf, NULL);
+            vkFreeMemory(s_dev, s_fgb[i].mem, NULL);
+        }
+        memset(s_fgb, 0, sizeof s_fgb);
+    }
+    s_fg_state = -1;
+    if (!s_fg_layout) {
+        VkDescriptorSetLayoutBinding b[12];
+        VkDescriptorSetLayoutCreateInfo lci = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+        memset(b, 0, sizeof b);
+        for (i = 0; i < 12; i++) {
+            b[i].binding = (uint32_t)i;
+            b[i].descriptorCount = 1;
+            b[i].descriptorType = i < 3 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+            b[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        }
+        lci.flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;
+        lci.bindingCount = 12;
+        lci.pBindings = b;
+        if (vkCreateDescriptorSetLayout(s_dev, &lci, NULL, &s_fg_dsl) != VK_SUCCESS ||
+            !(s_fg_layout = post_layout(s_fg_dsl, VK_SHADER_STAGE_COMPUTE_BIT, 32)))
+            return 0;
+        for (i = 0; i < FG_N; i++) {
+            VkComputePipelineCreateInfo ci = { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+            VkShaderModule m = post_module(k[i].code, k[i].bytes);
+            if (!m)
+                return 0;
+            ci.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+            ci.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+            ci.stage.module = m;
+            ci.stage.pName = "main";
+            ci.layout = s_fg_layout;
+            if (vkCreateComputePipelines(s_dev, s_pcache, 1, &ci, NULL, &s_fg_pipe[i]) != VK_SUCCESS)
+                s_fg_pipe[i] = VK_NULL_HANDLE;
+            vkDestroyShaderModule(s_dev, m, NULL);
+            if (!s_fg_pipe[i]) {
+                LOGE("frame generation: pipeline %d failed; off\n", i);
+                return 0;
+            }
+        }
+    }
+    sizes[FB_LUMA0] = sizes[FB_LUMA1] = sizes[FB_PICKS] = (VkDeviceSize)lw * lh * 4;
+    sizes[FB_PROJ0] = sizes[FB_PROJ1] = (VkDeviceSize)(lw + lh) * 4;
+    sizes[FB_COSTS] = FG_GN * 4;
+    sizes[FB_VEC0] = sizes[FB_VEC1] = (VkDeviceSize)bw * bh * 4;
+    sizes[FB_COUNT] = 16;
+    end_rendering();
+    for (i = 0; i < FB_N; i++)
+        if (!post_buf(&s_fgb[i], sizes[i])) {
+            LOGE("frame generation: no memory for its buffers; off\n");
+            return 0;
+        }
+    post_barrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+    s_fg_w = w;
+    s_fg_h = h;
+    s_fg_have = 0;
+    s_fg_state = 1;
+    fprintf(stderr, "  [VK] frame generation ready: %ux%u, luma %ux%u, %ux%u blocks\n", w, h, lw, lh, bw, bh);
+    return 1;
+}
+
+/* One frame generation pass: every binding pushed, the newest frame c and the
+ * one before it p. */
+static void fg_dispatch(int k, uint32_t gx, uint32_t gy)
+{
+    int c = s_fg_cur, p = c ^ 1, i;
+    VkDescriptorImageInfo im[3];
+    VkDescriptorBufferInfo bi[9];
+    VkWriteDescriptorSet wr[12];
+    const int bufs[9] = { FB_LUMA0 + p, FB_LUMA0 + c, FB_PROJ0 + p, FB_PROJ0 + c, FB_COSTS,
+                          FB_VEC0 + p, FB_VEC0 + c, FB_PICKS, FB_COUNT };
+    int32_t pc[8];
+    uint32_t lw = (s_fg_w + 3) / 4, lh = (s_fg_h + 3) / 4;
+
+    memset(wr, 0, sizeof wr);
+    im[0].imageView = s_out[p].view;
+    im[1].imageView = s_out[c].view;
+    im[2].imageView = s_mid.view;
+    for (i = 0; i < 3; i++) {
+        im[i].sampler = VK_NULL_HANDLE;
+        im[i].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+        wr[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        wr[i].dstBinding = (uint32_t)i;
+        wr[i].descriptorCount = 1;
+        wr[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        wr[i].pImageInfo = &im[i];
+    }
+    for (i = 0; i < 9; i++) {
+        bi[i].buffer = s_fgb[bufs[i]].buf;
+        bi[i].offset = 0;
+        bi[i].range = VK_WHOLE_SIZE;
+        wr[3 + i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        wr[3 + i].dstBinding = (uint32_t)(3 + i);
+        wr[3 + i].descriptorCount = 1;
+        wr[3 + i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        wr[3 + i].pBufferInfo = &bi[i];
+    }
+    pc[0] = (int32_t)s_fg_w; pc[1] = (int32_t)s_fg_h;
+    pc[2] = (int32_t)lw; pc[3] = (int32_t)lh;
+    pc[4] = (int32_t)((lw + 3) / 4); pc[5] = (int32_t)((lh + 3) / 4);
+    pc[6] = pc[7] = 0;
+    vkCmdBindPipeline(s_cb, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg_pipe[k]);
+    p_push_desc(s_cb, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg_layout, 0, 12, wr);
+    vkCmdPushConstants(s_cb, s_fg_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+    vkCmdDispatch(s_cb, gx, gy, 1);
+    post_barrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                 VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT);
+}
+
+/* The passes over the newest frame (s_out[s_fg_cur]): its luma and means always,
+ * the in-between frame into s_mid when there is a frame before it. */
+static int fg_passes(void)
+{
+    uint32_t lw = (s_fg_w + 3) / 4, lh = (s_fg_h + 3) / 4, bw = (lw + 3) / 4, bh = (lh + 3) / 4;
+    fg_dispatch(FG_LUMA, (lw + 7) / 8, (lh + 7) / 8);
+    fg_dispatch(FG_PROJ, (lw + lh + 63) / 64, 1);
+    if (s_fg_have < 2)
+        return 0;
+    fg_dispatch(FG_GLOBAL, (FG_GN + 63) / 64, 1);
+    fg_dispatch(FG_MOTION, (bw + 7) / 8, (bh + 7) / 8);
+    fg_dispatch(FG_SELECT, (lw + 7) / 8, (lh + 7) / 8);
+    fg_dispatch(FG_INTERP, (s_fg_w + 7) / 8, (s_fg_h + 7) / 8);
+    return 1;
+}
+
+static void post_blit(VkImage src, VkImage sc, VkExtent2D ext)
+{
+    VkImageBlit bl;
+    swapchain_layout(sc, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0,
+                     VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    memset(&bl, 0, sizeof bl);
+    bl.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    bl.srcSubresource.layerCount = 1;
+    bl.srcOffsets[1].x = (int32_t)ext.width;
+    bl.srcOffsets[1].y = (int32_t)ext.height;
+    bl.srcOffsets[1].z = 1;
+    bl.dstSubresource = bl.srcSubresource;
+    bl.dstOffsets[1] = bl.srcOffsets[1];
+    vkCmdBlitImage(s_cb, src, VK_IMAGE_LAYOUT_GENERAL, sc, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bl,
+                   VK_FILTER_NEAREST);
+    swapchain_layout(sc, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+                     VK_ACCESS_TRANSFER_WRITE_BIT, 0, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+}
+
+/* Frame generation on the screen's swapchain this flip: off with the game at
+ * 60 (the port clears nv2a_vk_framegen) and without a swapchain. */
+static int fg_on(void)
+{
+    if (!nv2a_vk_framegen || s_headless) {
+        s_fg_have = 0;
+        return 0;
+    }
+    return fg_init(s_sc_extent.width, s_sc_extent.height);
+}
+
+/* The picture of this flip into swapchain image idx (already acquired), with
+ * FSR and frame generation as the menu has them. With an in-between frame, it
+ * goes into idx and the real frame into a second image (s_idx2), presented
+ * after it. 0 = nothing recorded (the plain FXAA path or the blit draws it). */
+static int post_present(VkSurf *s, uint32_t idx, int dx, int dy, int dw, int dh)
+{
+    VkExtent2D ext = s_sc_extent;
+    int c;
+
+    s_idx2 = -1;
+    if (!fg_on())
+        return nv2a_vk_upscale && post_fsr(s, s_sc_images[idx], s_sc_views[idx], s_sc_format, ext,
+                                           dx, dy, dw, dh, 1);
+    if (!post_img(&s_out[0], ext.width, ext.height, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                  VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT) ||
+        !post_img(&s_out[1], ext.width, ext.height, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                  VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT) ||
+        !post_img(&s_mid, ext.width, ext.height, VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+        return 0;
+    /* the new frame into the older of the two */
+    c = s_fg_have ? s_fg_cur ^ 1 : 0;
+    /* the flip before read it (frame generation, the blit): done first */
+    end_rendering();
+    post_barrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                 VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT,
+                 VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT);
+    if (!(nv2a_vk_upscale && post_fsr(s, VK_NULL_HANDLE, s_out[c].view, POST_FMT, ext, dx, dy, dw, dh, 1))) {
+        s_pp_osd = 1;
+        if (!present_fxaa(s, s_out[c].image, s_out[c].view, POST_FMT, ext, dx, dy, dw, dh,
+                          VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT)) {
+            s_pp_osd = 0;
+            return 0;
+        }
+        s_pp_osd = 0;
+        post_barrier(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                     VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT);
+    }
+    s_fg_cur = c;
+    if (s_fg_have < 2)
+        s_fg_have++;
+    if (fg_passes()) {
+        uint32_t idx2;
+        VkResult rr = vkAcquireNextImageKHR(s_dev, s_swapchain, UINT64_MAX, s_f->acquired2, VK_NULL_HANDLE, &idx2);
+        if (rr == VK_SUCCESS || rr == VK_SUBOPTIMAL_KHR) {
+            post_blit(s_mid.image, s_sc_images[idx], ext);
+            post_blit(s_out[c].image, s_sc_images[idx2], ext);
+            s_idx2 = (int)idx2;
+            return 1;
+        }
+    }
+    post_blit(s_out[c].image, s_sc_images[idx], ext);
+    return 1;
+}
