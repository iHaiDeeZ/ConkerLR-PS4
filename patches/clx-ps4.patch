+  AH2 mn4B=min(AMin3H2(bB,dB,fB),hB);
+  AH2 mx4R=max(AMax3H2(bR,dR,fR),hR);
+  AH2 mx4G=max(AMax3H2(bG,dG,fG),hG);
+  AH2 mx4B=max(AMax3H2(bB,dB,fB),hB);
+  // Immediate constants for peak range.
+  AH2 peakC=AH2(1.0,-1.0*4.0);
+  // Limiters, these need to be high precision RCPs.
+  AH2 hitMinR=min(mn4R,eR)*ARcpH2(AH2_(4.0)*mx4R);
+  AH2 hitMinG=min(mn4G,eG)*ARcpH2(AH2_(4.0)*mx4G);
+  AH2 hitMinB=min(mn4B,eB)*ARcpH2(AH2_(4.0)*mx4B);
+  AH2 hitMaxR=(peakC.x-max(mx4R,eR))*ARcpH2(AH2_(4.0)*mn4R+peakC.y);
+  AH2 hitMaxG=(peakC.x-max(mx4G,eG))*ARcpH2(AH2_(4.0)*mn4G+peakC.y);
+  AH2 hitMaxB=(peakC.x-max(mx4B,eB))*ARcpH2(AH2_(4.0)*mn4B+peakC.y);
+  AH2 lobeR=max(-hitMinR,hitMaxR);
+  AH2 lobeG=max(-hitMinG,hitMaxG);
+  AH2 lobeB=max(-hitMinB,hitMaxB);
+  AH2 lobe=max(AH2_(-FSR_RCAS_LIMIT),min(AMax3H2(lobeR,lobeG,lobeB),AH2_(0.0)))*AH2_(AH2_AU1(con.y).x);
+  // Apply noise removal.
+  #ifdef FSR_RCAS_DENOISE
+   lobe*=nz;
+  #endif
+  // Resolve, which needs the medium precision rcp approximation to avoid visible tonality changes.
+  AH2 rcpL=APrxMedRcpH2(AH2_(4.0)*lobe+AH2_(1.0));
+  pixR=(lobe*bR+lobe*dR+lobe*hR+lobe*fR+eR)*rcpL;
+  pixG=(lobe*bG+lobe*dG+lobe*hG+lobe*fG+eG)*rcpL;
+  pixB=(lobe*bB+lobe*dB+lobe*hB+lobe*fB+eB)*rcpL;}
+#endif
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                          FSR - [LFGA] LINEAR FILM GRAIN APPLICATOR
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// Adding output-resolution film grain after scaling is a good way to mask both rendering and scaling artifacts.
+// Suggest using tiled blue noise as film grain input, with peak noise frequency set for a specific look and feel.
+// The 'Lfga*()' functions provide a convenient way to introduce grain.
+// These functions limit grain based on distance to signal limits.
+// This is done so that the grain is temporally energy preserving, and thus won't modify image tonality.
+// Grain application should be done in a linear colorspace.
+// The grain should be temporally changing, but have a temporal sum per pixel that adds to zero (non-biased).
+//------------------------------------------------------------------------------------------------------------------------------
+// Usage,
+//   FsrLfga*(
+//    color, // In/out linear colorspace color {0 to 1} ranged.
+//    grain, // Per pixel grain texture value {-0.5 to 0.5} ranged, input is 3-channel to support colored grain.
+//    amount); // Amount of grain (0 to 1} ranged.
+//------------------------------------------------------------------------------------------------------------------------------
+// Example if grain texture is monochrome: 'FsrLfgaF(color,AF3_(grain),amount)'
+//==============================================================================================================================
+#if defined(A_GPU)
+ // Maximum grain is the minimum distance to the signal limit.
+ void FsrLfgaF(inout AF3 c,AF3 t,AF1 a){c+=(t*AF3_(a))*min(AF3_(1.0)-c,c);}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ // Half precision version (slower).
+ void FsrLfgaH(inout AH3 c,AH3 t,AH1 a){c+=(t*AH3_(a))*min(AH3_(1.0)-c,c);}
+//------------------------------------------------------------------------------------------------------------------------------
+ // Packed half precision version (faster).
+ void FsrLfgaHx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 tR,AH2 tG,AH2 tB,AH1 a){
+  cR+=(tR*AH2_(a))*min(AH2_(1.0)-cR,cR);cG+=(tG*AH2_(a))*min(AH2_(1.0)-cG,cG);cB+=(tB*AH2_(a))*min(AH2_(1.0)-cB,cB);}
+#endif
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                          FSR - [SRTM] SIMPLE REVERSIBLE TONE-MAPPER
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// This provides a way to take linear HDR color {0 to FP16_MAX} and convert it into a temporary {0 to 1} ranged post-tonemapped linear.
+// The tonemapper preserves RGB ratio, which helps maintain HDR color bleed during filtering.
+//------------------------------------------------------------------------------------------------------------------------------
+// Reversible tonemapper usage,
+//  FsrSrtm*(color); // {0 to FP16_MAX} converted to {0 to 1}.
+//  FsrSrtmInv*(color); // {0 to 1} converted into {0 to 32768, output peak safe for FP16}.
+//==============================================================================================================================
+#if defined(A_GPU)
+ void FsrSrtmF(inout AF3 c){c*=AF3_(ARcpF1(AMax3F1(c.r,c.g,c.b)+AF1_(1.0)));}
+ // The extra max solves the c=1.0 case (which is a /0).
+ void FsrSrtmInvF(inout AF3 c){c*=AF3_(ARcpF1(max(AF1_(1.0/32768.0),AF1_(1.0)-AMax3F1(c.r,c.g,c.b))));}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ void FsrSrtmH(inout AH3 c){c*=AH3_(ARcpH1(AMax3H1(c.r,c.g,c.b)+AH1_(1.0)));}
+ void FsrSrtmInvH(inout AH3 c){c*=AH3_(ARcpH1(max(AH1_(1.0/32768.0),AH1_(1.0)-AMax3H1(c.r,c.g,c.b))));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrSrtmHx2(inout AH2 cR,inout AH2 cG,inout AH2 cB){
+  AH2 rcp=ARcpH2(AMax3H2(cR,cG,cB)+AH2_(1.0));cR*=rcp;cG*=rcp;cB*=rcp;}
+ void FsrSrtmInvHx2(inout AH2 cR,inout AH2 cG,inout AH2 cB){
+  AH2 rcp=ARcpH2(max(AH2_(1.0/32768.0),AH2_(1.0)-AMax3H2(cR,cG,cB)));cR*=rcp;cG*=rcp;cB*=rcp;}
+#endif
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//_____________________________________________________________/\_______________________________________________________________
+//==============================================================================================================================
+//
+//                                       FSR - [TEPD] TEMPORAL ENERGY PRESERVING DITHER
+//
+//------------------------------------------------------------------------------------------------------------------------------
+// Temporally energy preserving dithered {0 to 1} linear to gamma 2.0 conversion.
+// Gamma 2.0 is used so that the conversion back to linear is just to square the color.
+// The conversion comes in 8-bit and 10-bit modes, designed for output to 8-bit UNORM or 10:10:10:2 respectively.
+// Given good non-biased temporal blue noise as dither input,
+// the output dither will temporally conserve energy.
+// This is done by choosing the linear nearest step point instead of perceptual nearest.
+// See code below for details.
+//------------------------------------------------------------------------------------------------------------------------------
+// DX SPEC RULES FOR FLOAT->UNORM 8-BIT CONVERSION
+// ===============================================
+// - Output is 'uint(floor(saturate(n)*255.0+0.5))'.
+// - Thus rounding is to nearest.
+// - NaN gets converted to zero.
+// - INF is clamped to {0.0 to 1.0}.
+//==============================================================================================================================
+#if defined(A_GPU)
+ // Hand tuned integer position to dither value, with more values than simple checkerboard.
+ // Only 32-bit has enough precision for this compddation.
+ // Output is {0 to <1}.
+ AF1 FsrTepdDitF(AU2 p,AU1 f){
+  AF1 x=AF1_(p.x+f);
+  AF1 y=AF1_(p.y);
+  // The 1.61803 golden ratio.
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  // Number designed to provide a good visual pattern.
+  AF1 b=AF1_(1.0/3.69);
+  x=x*a+(y*b);
+  return AFractF1(x);}
+//------------------------------------------------------------------------------------------------------------------------------
+ // This version is 8-bit gamma 2.0.
+ // The 'c' input is {0 to 1}.
+ // Output is {0 to 1} ready for image store.
+ void FsrTepdC8F(inout AF3 c,AF1 dit){
+  AF3 n=sqrt(c);
+  n=floor(n*AF3_(255.0))*AF3_(1.0/255.0);
+  AF3 a=n*n;
+  AF3 b=n+AF3_(1.0/255.0);b=b*b;
+  // Ratio of 'a' to 'b' required to produce 'c'.
+  // APrxLoRcpF1() won't work here (at least for very high dynamic ranges).
+  // APrxMedRcpF1() is an IADD,FMA,MUL.
+  AF3 r=(c-b)*APrxMedRcpF3(a-b);
+  // Use the ratio as a cutoff to choose 'a' or 'b'.
+  // AGtZeroF1() is a MUL.
+  c=ASatF3(n+AGtZeroF3(AF3_(dit)-r)*AF3_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ // This version is 10-bit gamma 2.0.
+ // The 'c' input is {0 to 1}.
+ // Output is {0 to 1} ready for image store.
+ void FsrTepdC10F(inout AF3 c,AF1 dit){
+  AF3 n=sqrt(c);
+  n=floor(n*AF3_(1023.0))*AF3_(1.0/1023.0);
+  AF3 a=n*n;
+  AF3 b=n+AF3_(1.0/1023.0);b=b*b;
+  AF3 r=(c-b)*APrxMedRcpF3(a-b);
+  c=ASatF3(n+AGtZeroF3(AF3_(dit)-r)*AF3_(1.0/1023.0));}
+#endif
+//==============================================================================================================================
+#if defined(A_GPU)&&defined(A_HALF)
+ AH1 FsrTepdDitH(AU2 p,AU1 f){
+  AF1 x=AF1_(p.x+f);
+  AF1 y=AF1_(p.y);
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  AF1 b=AF1_(1.0/3.69);
+  x=x*a+(y*b);
+  return AH1(AFractF1(x));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC8H(inout AH3 c,AH1 dit){
+  AH3 n=sqrt(c);
+  n=floor(n*AH3_(255.0))*AH3_(1.0/255.0);
+  AH3 a=n*n;
+  AH3 b=n+AH3_(1.0/255.0);b=b*b;
+  AH3 r=(c-b)*APrxMedRcpH3(a-b);
+  c=ASatH3(n+AGtZeroH3(AH3_(dit)-r)*AH3_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC10H(inout AH3 c,AH1 dit){
+  AH3 n=sqrt(c);
+  n=floor(n*AH3_(1023.0))*AH3_(1.0/1023.0);
+  AH3 a=n*n;
+  AH3 b=n+AH3_(1.0/1023.0);b=b*b;
+  AH3 r=(c-b)*APrxMedRcpH3(a-b);
+  c=ASatH3(n+AGtZeroH3(AH3_(dit)-r)*AH3_(1.0/1023.0));}
+//==============================================================================================================================
+ // This computes dither for positions 'p' and 'p+{8,0}'.
+ AH2 FsrTepdDitHx2(AU2 p,AU1 f){
+  AF2 x;
+  x.x=AF1_(p.x+f);
+  x.y=x.x+AF1_(8.0);
+  AF1 y=AF1_(p.y);
+  AF1 a=AF1_((1.0+sqrt(5.0))/2.0);
+  AF1 b=AF1_(1.0/3.69);
+  x=x*AF2_(a)+AF2_(y*b);
+  return AH2(AFractF2(x));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC8Hx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 dit){
+  AH2 nR=sqrt(cR);
+  AH2 nG=sqrt(cG);
+  AH2 nB=sqrt(cB);
+  nR=floor(nR*AH2_(255.0))*AH2_(1.0/255.0);
+  nG=floor(nG*AH2_(255.0))*AH2_(1.0/255.0);
+  nB=floor(nB*AH2_(255.0))*AH2_(1.0/255.0);
+  AH2 aR=nR*nR;
+  AH2 aG=nG*nG;
+  AH2 aB=nB*nB;
+  AH2 bR=nR+AH2_(1.0/255.0);bR=bR*bR;
+  AH2 bG=nG+AH2_(1.0/255.0);bG=bG*bG;
+  AH2 bB=nB+AH2_(1.0/255.0);bB=bB*bB;
+  AH2 rR=(cR-bR)*APrxMedRcpH2(aR-bR);
+  AH2 rG=(cG-bG)*APrxMedRcpH2(aG-bG);
+  AH2 rB=(cB-bB)*APrxMedRcpH2(aB-bB);
+  cR=ASatH2(nR+AGtZeroH2(dit-rR)*AH2_(1.0/255.0));
+  cG=ASatH2(nG+AGtZeroH2(dit-rG)*AH2_(1.0/255.0));
+  cB=ASatH2(nB+AGtZeroH2(dit-rB)*AH2_(1.0/255.0));}
+//------------------------------------------------------------------------------------------------------------------------------
+ void FsrTepdC10Hx2(inout AH2 cR,inout AH2 cG,inout AH2 cB,AH2 dit){
+  AH2 nR=sqrt(cR);
+  AH2 nG=sqrt(cG);
+  AH2 nB=sqrt(cB);
+  nR=floor(nR*AH2_(1023.0))*AH2_(1.0/1023.0);
+  nG=floor(nG*AH2_(1023.0))*AH2_(1.0/1023.0);
+  nB=floor(nB*AH2_(1023.0))*AH2_(1.0/1023.0);
+  AH2 aR=nR*nR;
+  AH2 aG=nG*nG;
+  AH2 aB=nB*nB;
+  AH2 bR=nR+AH2_(1.0/1023.0);bR=bR*bR;
+  AH2 bG=nG+AH2_(1.0/1023.0);bG=bG*bG;
+  AH2 bB=nB+AH2_(1.0/1023.0);bB=bB*bB;
+  AH2 rR=(cR-bR)*APrxMedRcpH2(aR-bR);
+  AH2 rG=(cG-bG)*APrxMedRcpH2(aG-bG);
+  AH2 rB=(cB-bB)*APrxMedRcpH2(aB-bB);
+  cR=ASatH2(nR+AGtZeroH2(dit-rR)*AH2_(1.0/1023.0));
+  cG=ASatH2(nG+AGtZeroH2(dit-rG)*AH2_(1.0/1023.0));
+  cB=ASatH2(nB+AGtZeroH2(dit-rB)*AH2_(1.0/1023.0));}
+#endif
diff --git a/xboxrecomp/src/nv2a_vk/shaders/fg.comp b/xboxrecomp/src/nv2a_vk/shaders/fg.comp
new file mode 100644
index 0000000..654b81f
--- /dev/null
+++ b/xboxrecomp/src/nv2a_vk/shaders/fg.comp
@@ -0,0 +1,256 @@
+#version 450
+// Frame generation (ps4_post.h): for a game at 30 fps, an in-between frame from
+// the motion between its last two frames, shown a vblank before the newer one,
+// so the screen gets 60. The frames are the pictures as shown (1920x1080, after
+// FXAA or FSR). DawnStation's frame generation v3 (PS2 project,
+// overlay/framegen.cl: GCN kernels), the same passes in Vulkan compute; this
+// file is built once per pass, with FG_<PASS> defined:
+//
+//   LUMA    the new frame's brightness at a quarter of its size (4x4 average)
+//   PROJ    that image's column means, then its row means
+//   GLOBAL  how well the previous frame's means match the new ones for each
+//           shift of the whole picture (-63..63 across, -31..31 down): a
+//           camera turn moves everything alike
+//   MOTION  per 4x4 block of the luma, where it was in the previous frame's
+//           (8x8 around it, a checkerboard): searches from no motion (steps
+//           16..1), from the block's vector of the frame before (2, 1) and from
+//           the whole picture's best shift (4, 2, 1); ties keep the earlier
+//   SELECT  per quarter-size pixel, the one of its 3x3 blocks' vectors (or
+//           none) along which the two frames agree best halfway, with how well,
+//           and a count of the poor ones
+//   INTERP  each pixel from both frames halfway along its pick, averaged; the
+//           newer frame where the match is poor (cuts, flashes) or where the
+//           pixel is the same in both (the HUD)
+#extension GL_KHR_shader_subgroup_ballot : enable
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(set = 0, binding = 0, rgba8) uniform readonly image2D prevImg;
+layout(set = 0, binding = 1, rgba8) uniform readonly image2D curImg;
+layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dstImg;
+layout(std430, set = 0, binding = 3) buffer LumaPrev { float lumaPrev[]; };
+layout(std430, set = 0, binding = 4) buffer LumaCur { float lumaCur[]; };
+layout(std430, set = 0, binding = 5) buffer ProjPrev { float projPrev[]; };
+layout(std430, set = 0, binding = 6) buffer ProjCur { float projCur[]; };
+layout(std430, set = 0, binding = 7) buffer Costs { float costs[]; };
+layout(std430, set = 0, binding = 8) buffer VecLast { uint vecLast[]; };
+layout(std430, set = 0, binding = 9) buffer VecCur { uint vecCur[]; };
+layout(std430, set = 0, binding = 10) buffer Picks { uint picks[]; };
+layout(std430, set = 0, binding = 11) buffer Count { uint poorCount; };
+
+layout(push_constant) uniform Constants {
+    int W, H;       // the frames
+    int LW, LH;     // the luma: W / 4, H / 4
+    int BW, BH;     // motion blocks: LW / 4, LH / 4 rounded up
+} pc;
+
+#define BS 4
+#define GX 63
+#define GY 31
+#define GN (2 * GX + 1 + 2 * GY + 1)
+// Where no motion fits, the newer frame: per pixel as its pick's mean halfway
+// difference goes from PIXEL_LO to PIXEL_HI, for the whole frame as the share
+// of poor picks goes from SHARE_LO to SHARE_HI (tuned on GTA San Andreas).
+const float POOR = 0.08;
+const float SHARE_LO = 0.15, SHARE_HI = 0.25;
+const float PIXEL_LO = 0.10, PIXEL_HI = 0.20;
+
+int lofs(int x, int y)
+{
+    return clamp(y, 0, pc.LH - 1) * pc.LW + clamp(x, 0, pc.LW - 1);
+}
+
+int linear_id()
+{
+    return int(gl_WorkGroupID.x) * 64 + int(gl_LocalInvocationID.y) * 8 + int(gl_LocalInvocationID.x);
+}
+
+uint pack_vector(int dx, int dy) { return (uint(dx) & 0xffffu) | (uint(dy) << 16); }
+int vector_x(uint v) { return bitfieldExtract(int(v), 0, 16); }
+int vector_y(uint v) { return bitfieldExtract(int(v), 16, 16); }
+
+#if defined(FG_LUMA)
+void main()
+{
+    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
+    float s = 0.0;
+    if (q.x >= pc.LW || q.y >= pc.LH)
+        return;
+    for (int j = 0; j < 4; j++)
+        for (int i = 0; i < 4; i++) {
+            vec3 c = imageLoad(curImg, clamp(q * 4 + ivec2(i, j), ivec2(0), ivec2(pc.W - 1, pc.H - 1))).rgb;
+            s += dot(c, vec3(0.299, 0.587, 0.114));
+        }
+    lumaCur[q.y * pc.LW + q.x] = s * (1.0 / 16.0);
+}
+#elif defined(FG_PROJ)
+void main()
+{
+    int i = linear_id();
+    float s = 0.0;
+    if (i < pc.LW) {
+        for (int y = 0; y < pc.LH; y++)
+            s += lumaCur[y * pc.LW + i];
+        projCur[i] = s / float(pc.LH);
+    } else if (i < pc.LW + pc.LH) {
+        int y = i - pc.LW;
+        for (int x = 0; x < pc.LW; x++)
+            s += lumaCur[y * pc.LW + x];
+        projCur[i] = s / float(pc.LW);
+    }
+}
+#elif defined(FG_GLOBAL)
+// the new frame at p was the previous one at p + shift
+void main()
+{
+    int j = linear_id();
+    bool across = j < 2 * GX + 1;
+    int s = across ? j - GX : j - (2 * GX + 1) - GY;
+    int n = across ? pc.LW : pc.LH, base = across ? 0 : pc.LW;
+    int lo = s < 0 ? -s : 0, hi = s > 0 ? n - s : n;
+    float d = 0.0;
+    if (j == 0)
+        poorCount = 0u;     // SELECT counts into it next
+    if (j >= GN)
+        return;
+    for (int i = lo; i < hi; i++)
+        d += abs(projCur[base + i] - projPrev[base + i + s]);
+    costs[j] = 2 * (hi - lo) >= n ? d / float(hi - lo) : 1e30;
+}
+#elif defined(FG_MOTION)
+// the block's sum of absolute differences over the 8x8 around it (every other
+// pixel, doubled) against the previous luma moved by (dx, dy)
+float sad(int bx, int by, int dx, int dy)
+{
+    int x0 = bx * BS - 2, y0 = by * BS - 2;
+    float s = 0.0;
+    for (int j = 0; j < 8; j++)
+        for (int i = j & 1; i < 8; i += 2)
+            s += abs(lumaCur[lofs(x0 + i, y0 + j)] - lumaPrev[lofs(x0 + i + dx, y0 + j + dy)]);
+    return s * 2.0;
+}
+
+uint block_vector_last(int bx, int by)
+{
+    return vecLast[clamp(by, 0, pc.BH - 1) * pc.BW + clamp(bx, 0, pc.BW - 1)];
+}
+
+void main()
+{
+    int bx = int(gl_GlobalInvocationID.x), by = int(gl_GlobalInvocationID.y);
+    int gx = 0, gy = 0, dx = 0, dy = 0;
+    float gbx = 1e30, gby = 1e30, best = 0.0;
+    if (bx >= pc.BW || by >= pc.BH)
+        return;
+    // the whole picture's shift: GLOBAL's best across and best down
+    for (int j = 0; j < 2 * GX + 1; j++)
+        if (costs[j] < gbx) {
+            gbx = costs[j];
+            gx = j - GX;
+        }
+    for (int j = 0; j < 2 * GY + 1; j++)
+        if (costs[2 * GX + 1 + j] < gby) {
+            gby = costs[2 * GX + 1 + j];
+            gy = j - GY;
+        }
+    uint t = block_vector_last(bx, by);
+    for (int pass = 0; pass < 3; pass++) {
+        int sx = pass == 1 ? vector_x(t) : pass == 2 ? gx : 0;
+        int sy = pass == 1 ? vector_y(t) : pass == 2 ? gy : 0;
+        float sbest = sad(bx, by, sx, sy);
+        for (int step = pass == 1 ? 2 : pass == 2 ? 4 : 16; step >= 1; step >>= 1) {
+            int nx = sx, ny = sy;
+            float nbest = sbest;
+            for (int k = 0; k < 9; k++) {
+                if (k == 4)
+                    continue;
+                int cx = sx + (k % 3 - 1) * step, cy = sy + (k / 3 - 1) * step;
+                float c = sad(bx, by, cx, cy);
+                if (c < nbest) {
+                    nbest = c;
+                    nx = cx;
+                    ny = cy;
+                }
+            }
+            sx = nx;
+            sy = ny;
+            sbest = nbest;
+        }
+        if (pass == 0 || sbest < best) {
+            best = sbest;
+            dx = sx;
+            dy = sy;
+        }
+    }
+    vecCur[by * pc.BW + bx] = pack_vector(dx, dy);
+}
+#elif defined(FG_SELECT)
+// how badly the two frames disagree halfway along v around (qx, qy): 3x3
+// samples 2 apart; the previous frame moved by v lands on the new one
+float halfway_cost(int qx, int qy, int vx, int vy)
+{
+    int ax = (vx + 1) >> 1, ay = (vy + 1) >> 1;    // the previous frame: v / 2 rounded up
+    int bx = vx >> 1, by = vy >> 1;                // the new one: rounded down
+    float s = 0.0;
+    for (int j = -2; j <= 2; j += 2)
+        for (int i = -2; i <= 2; i += 2)
+            s += abs(lumaPrev[lofs(qx + i + ax, qy + j + ay)] - lumaCur[lofs(qx + i - bx, qy + j - by)]);
+    return s;
+}
+
+void main()
+{
+    int qx = int(gl_GlobalInvocationID.x), qy = int(gl_GlobalInvocationID.y);
+    int bx = qx / BS, by = qy / BS;
+    uint pick = 0u;                 // no motion first: it wins ties (still pictures, the HUD)
+    float best = halfway_cost(qx, qy, 0, 0);
+    for (int k = 0; k < 9; k++) {
+        uint v = vecCur[clamp(by + k / 3 - 1, 0, pc.BH - 1) * pc.BW + clamp(bx + k % 3 - 1, 0, pc.BW - 1)];
+        float c = halfway_cost(qx, qy, vector_x(v), vector_y(v));
+        if (c < best) {
+            best = c;
+            pick = v;
+        }
+    }
+    bool inside = qx < pc.LW && qy < pc.LH;
+    float mean = best * (1.0 / 9.0);
+    uvec4 poor = subgroupBallot(inside && mean > POOR);
+    if (subgroupElect()) {
+        uint n = subgroupBallotBitCount(poor);
+        if (n != 0u)
+            atomicAdd(poorCount, n);
+    }
+    if (!inside)
+        return;
+    int px = clamp(vector_x(pick), -127, 127), py = clamp(vector_y(pick), -127, 127);
+    uint quality = uint(min(mean, 1.0) * 65535.0 + 0.5);
+    picks[qy * pc.LW + qx] = (uint(px) & 0xffu) | ((uint(py) & 0xffu) << 8) | (quality << 16);
+}
+#elif defined(FG_INTERP)
+void main()
+{
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 hi = ivec2(pc.W - 1, pc.H - 1);
+    if (p.x >= pc.W || p.y >= pc.H)
+        return;
+    // the new frame's pixel at p was at p + 4v (screen pixels) in the old one:
+    // halfway is 2v
+    uint v = picks[lofs(p.x >> 2, p.y >> 2)];
+    ivec2 h = 2 * ivec2(bitfieldExtract(int(v), 0, 8), bitfieldExtract(int(v), 8, 8));
+    vec3 a = imageLoad(prevImg, clamp(p + h, ivec2(0), hi)).rgb;
+    vec3 b = imageLoad(curImg, clamp(p - h, ivec2(0), hi)).rgb;
+    vec3 here = imageLoad(curImg, p).rgb;
+    vec3 was = imageLoad(prevImg, p).rgb;
+    // their average: where they still disagree, a blend reads as motion blur
+    vec3 pix = (a + b) * 0.5;
+    // a pixel the same in both frames stays as it is (the HUD)
+    bool still = all(lessThan(abs(here - was), vec3(0.002)));
+    // where no motion fits, the newer frame instead
+    float share = float(poorCount) / float(pc.LW * pc.LH);
+    float quality = float(v >> 16) * (1.0 / 65535.0);
+    float fallback = still ? 1.0
+        : max(clamp((share - SHARE_LO) / (SHARE_HI - SHARE_LO), 0.0, 1.0),
+              clamp((quality - PIXEL_LO) / (PIXEL_HI - PIXEL_LO), 0.0, 1.0));
+    imageStore(dstImg, p, vec4(mix(pix, here, fallback), 1.0));
+}
+#endif
diff --git a/xboxrecomp/src/nv2a_vk/shaders/fsr_easu.frag b/xboxrecomp/src/nv2a_vk/shaders/fsr_easu.frag
new file mode 100644
index 0000000..52b9f85
--- /dev/null
+++ b/xboxrecomp/src/nv2a_vk/shaders/fsr_easu.frag
@@ -0,0 +1,30 @@
+#version 450
+// FSR 1 upscaling, its first pass (EASU) as a full-screen fragment shader: the
+// game's picture at its render size into an image at the size it is shown
+// (ps4_post.h). The 32-bit path: the PS4's GCN has no 16-bit floats.
+#extension GL_GOOGLE_include_directive : enable
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+
+layout(set = 0, binding = 0) uniform sampler2D src;
+
+layout(push_constant) uniform Constants {
+    uvec4 con0, con1, con2, con3;   // FsrEasuCon (ps4_post.h)
+} pc;
+
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return textureGather(src, p, 0); }
+AF4 FsrEasuGF(AF2 p) { return textureGather(src, p, 1); }
+AF4 FsrEasuBF(AF2 p) { return textureGather(src, p, 2); }
+#include "ffx_fsr1.h"
+
+layout(location = 0) out vec4 o;
+
+void main()
+{
+    AF3 c;
+    FsrEasuF(c, AU2(gl_FragCoord.xy), pc.con0, pc.con1, pc.con2, pc.con3);
+    o = vec4(c, 1.0);
+}
diff --git a/xboxrecomp/src/nv2a_vk/shaders/fsr_rcas.frag b/xboxrecomp/src/nv2a_vk/shaders/fsr_rcas.frag
new file mode 100644
index 0000000..2e7aa31
--- /dev/null
+++ b/xboxrecomp/src/nv2a_vk/shaders/fsr_rcas.frag
@@ -0,0 +1,36 @@
+#version 450
+// FSR 1's sharpening pass (RCAS) on EASU's image, drawn into the rectangle the
+// picture takes on the screen, with the port's overlay (the quick menu) over
+// it (ps4_post.h).
+#extension GL_GOOGLE_include_directive : enable
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+
+layout(set = 0, binding = 0) uniform sampler2D src;
+layout(set = 0, binding = 1) uniform sampler2D ovl;
+
+layout(push_constant) uniform Constants {
+    uvec4 con;      // FsrRcasCon
+    vec4 rect;      // x, y, w, h on the target
+    vec4 flags;     // x: overlay shown
+} pc;
+
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(src, clamp(p, ASU2(0), textureSize(src, 0) - 1), 0); }
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+#include "ffx_fsr1.h"
+
+layout(location = 0) out vec4 o;
+
+void main()
+{
+    AF3 c;
+    FsrRcasF(c.r, c.g, c.b, AU2(gl_FragCoord.xy - pc.rect.xy), pc.con);
+    if (pc.flags.x > 0.5) {
+        vec4 v = textureLod(ovl, (gl_FragCoord.xy - pc.rect.xy) / pc.rect.zw, 0.0);
+        c = mix(c, v.rgb, v.a);
+    }
+    o = vec4(c, 1.0);
+}
