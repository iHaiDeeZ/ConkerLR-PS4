diff --git a/xboxrecomp/src/input/xinput_ps4.c b/xboxrecomp/src/input/xinput_ps4.c
new file mode 100644
index 0000000..98a3b7f
--- /dev/null
+++ b/xboxrecomp/src/input/xinput_ps4.c
@@ -0,0 +1,133 @@
+/*
+ * xinput_ps4.c -- the PS4's DualShock 4s as the Xbox gamepad.
+ *
+ * Read with scePad and handed over through the Switch reader's interface
+ * (xinput_nx.h), so xinput_device.c's console path serves both. Each user
+ * logged in when the game starts is a player, in login order (port 0 is the
+ * user who started the app when nobody else is).
+ *
+ *   Xbox            DualShock 4
+ *   A / B / X / Y   Cross / Circle / Square / Triangle (same positions)
+ *   White / Black   L1 / R1
+ *   LT / RT         L2 / R2 (analog)
+ *   Start           Options
+ *   Back            touch pad click (opens the settings menu)
+ *   sticks, clicks, D-pad as they are
+ */
+#ifdef __PS4__
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "xinput_nx.h"
+
+#define PS4_PADS 4
+
+static int32_t         s_handle[PS4_PADS] = { -1, -1, -1, -1 };
+static int             s_ready;
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void ps4_pad_open(int32_t user, int port)
+{
+    int32_t h = scePadOpen(user, 0, 0, NULL);
+    if (h < 0) {
+        fprintf(stderr, "  [PS4] pad: scePadOpen for user 0x%X failed (0x%08X)\n",
+                (unsigned)user, (unsigned)h);
+        return;
+    }
+    s_handle[port] = h;
+    fprintf(stderr, "  [PS4] pad %d: user 0x%X, handle %d\n", port + 1, (unsigned)user, h);
+}
+
+static void ps4_pad_init(void)
+{
+    OrbisUserServiceLoginUserIdList users;
+    int32_t first = -1;
+    int i, n = 0;
+
+    sceUserServiceInitialize(NULL);
+    scePadInit();
+    sceUserServiceGetInitialUser(&first);
+    if (first != -1)
+        ps4_pad_open(first, n++);
+    memset(&users, 0, sizeof users);
+    if (sceUserServiceGetLoginUserIdList(&users) == 0)
+        for (i = 0; i < 4 && n < PS4_PADS; i++)
+            if (users.userId[i] != -1 && users.userId[i] != 0 && users.userId[i] != first)
+                ps4_pad_open(users.userId[i], n++);
+    s_ready = 1;
+}
+
+/* 0..255 with the centre at 128 -> -32768..32767; flip turns +y up. */
+static int16_t ps4_axis(uint8_t v, int flip)
+{
+    int a = ((int)v - 128) * 256 + ((int)v > 128 ? 255 : 0);
+    if (flip)
+        a = -1 - a;
+    return (int16_t)(a < -32768 ? -32768 : a > 32767 ? 32767 : a);
+}
+
+int xbox_nx_pad_read(unsigned port, uint16_t *digital, uint8_t analog[8], int16_t thumbs[4])
+{
+    OrbisPadData d;
+    uint32_t b;
+
+    pthread_mutex_lock(&s_lock);
+    if (!s_ready)
+        ps4_pad_init();
+    pthread_mutex_unlock(&s_lock);
+    if (port >= PS4_PADS || s_handle[port] < 0)
+        return 0;
+    memset(&d, 0, sizeof d);
+    if (scePadReadState(s_handle[port], &d) != 0 || !d.connected)
+        return 0;
+    b = d.buttons;
+
+    *digital = 0;
+    if (b & ORBIS_PAD_BUTTON_UP)        *digital |= 0x0001;
+    if (b & ORBIS_PAD_BUTTON_DOWN)      *digital |= 0x0002;
+    if (b & ORBIS_PAD_BUTTON_LEFT)      *digital |= 0x0004;
+    if (b & ORBIS_PAD_BUTTON_RIGHT)     *digital |= 0x0008;
+    if (b & ORBIS_PAD_BUTTON_OPTIONS)   *digital |= 0x0010;   /* Start */
+    if (b & ORBIS_PAD_BUTTON_TOUCH_PAD) *digital |= 0x0020;   /* Back */
+    if (b & ORBIS_PAD_BUTTON_L3)        *digital |= 0x0040;
+    if (b & ORBIS_PAD_BUTTON_R3)        *digital |= 0x0080;
+
+    analog[NX_XBOX_A]     = (b & ORBIS_PAD_BUTTON_CROSS)    ? 255 : 0;
+    analog[NX_XBOX_B]     = (b & ORBIS_PAD_BUTTON_CIRCLE)   ? 255 : 0;
+    analog[NX_XBOX_X]     = (b & ORBIS_PAD_BUTTON_SQUARE)   ? 255 : 0;
+    analog[NX_XBOX_Y]     = (b & ORBIS_PAD_BUTTON_TRIANGLE) ? 255 : 0;
+    analog[NX_XBOX_BLACK] = (b & ORBIS_PAD_BUTTON_R1)       ? 255 : 0;
+    analog[NX_XBOX_WHITE] = (b & ORBIS_PAD_BUTTON_L1)       ? 255 : 0;
+    analog[NX_XBOX_LT]    = d.analogButtons.l2;
+    analog[NX_XBOX_RT]    = d.analogButtons.r2;
+
+    thumbs[0] = ps4_axis(d.leftStick.x, 0);
+    thumbs[1] = ps4_axis(d.leftStick.y, 1);
+    thumbs[2] = ps4_axis(d.rightStick.x, 0);
+    thumbs[3] = ps4_axis(d.rightStick.y, 1);
+    return 1;
+}
+
+void xbox_nx_pad_rumble(unsigned port, uint16_t left, uint16_t right)
+{
+    static int disabled = -1;
+    OrbisPadVibeParam v;
+
+    if (disabled < 0) {
+        const char *e = getenv("RECOMP_RUMBLE");
+        disabled = e && strcmp(e, "0") == 0;
+    }
+    if (disabled || port >= PS4_PADS || s_handle[port] < 0)
+        return;
+    memset(&v, 0, sizeof v);
+    v.lgMotor = (uint8_t)(left >> 8);    /* the Xbox's heavy left motor */
+    v.smMotor = (uint8_t)(right >> 8);
+    scePadSetVibration(s_handle[port], &v);
+}
+#endif
