diff --git a/src/ps4_clx.c b/src/ps4_clx.c
new file mode 100644
index 0000000..bd949a2
--- /dev/null
+++ b/src/ps4_clx.c
@@ -0,0 +1,111 @@
+/*
+ * ps4_clx.c -- PS4 boot glue for the Conker recompilation (ps4-kit).
+ *
+ *   data      /data/ConkerLR: saves (save/), the renderer's shader and
+ *             pipeline caches, clx_options.txt, the log; the disc itself is
+ *             in the package (/app0/game, main.c)
+ *   logs      stdout and stderr go to /data/ConkerLR/clx_log.txt (the last
+ *             run's is kept as clx_log-prev.txt); ps4-kit writes crash.log
+ *             and boot-trace.log beside it
+ *   settings  /data/ConkerLR/clx_env.txt, KEY=VALUE per line, '#' comments,
+ *             read into the environment (a console has none) -- the same
+ *             file as the Switch's
+ *   crashes   ps4-kit's crash handler calls ps4_crash_guest_info, which adds
+ *             the guest's registers and stack to the log
+ */
+#ifdef __PS4__
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "ps4_kit_diag.h"
+
+#define CLX_DATA_DIR "/data/ConkerLR"
+
+PS4_DIAG_DATA_DIR(CLX_DATA_DIR);
+
+#ifndef CLX_VERSION
+#define CLX_VERSION "00.00"
+#endif
+
+void print_guest_state(void);
+
+/* ps4-kit's crash handler, after its own report: the guest's view. */
+void ps4_crash_guest_info(void)
+{
+    fprintf(stderr, "[CRASH] guest state:\n");
+    print_guest_state();
+}
+
+static void log_open(void)
+{
+    const char *path = CLX_DATA_DIR "/clx_log.txt";
+    int fd;
+
+    rename(path, CLX_DATA_DIR "/clx_log-prev.txt");
+    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) {
+        ps4_boot_tracef("clx: cannot open %s (errno %d)", path, errno);
+        return;
+    }
+    /* dup2, not freopen: the C library's freopen closes the stream for good. */
+    dup2(fd, 1);
+    dup2(fd, 2);
+    close(fd);
+}
+
+static void load_env(void)
+{
+    FILE *f = fopen(CLX_DATA_DIR "/clx_env.txt", "r");
+    char line[1024];
+
+    if (!f) {
+        printf("[ps4] no " CLX_DATA_DIR "/clx_env.txt: default settings\n");
+        return;
+    }
+    while (fgets(line, sizeof line, f)) {
+        char *eq, *end = line + strlen(line);
+        while (end > line && (end[-1] == '\n' || end[-1] == '\r' || end[-1] == ' '))
+            *--end = 0;
+        if (!line[0] || line[0] == '#' || !(eq = strchr(line, '=')) || eq == line)
+            continue;
+        *eq = 0;
+        setenv(line, eq + 1, 1);
+        printf("[ps4] env %s=%s\n", line, eq + 1);
+    }
+    fclose(f);
+}
+
+void ps4_boot(void)
+{
+    mkdir(CLX_DATA_DIR, 0777);
+    mkdir(CLX_DATA_DIR "/save", 0777);
+    log_open();
+    printf("[ps4] Conker: Live & Reloaded for PS4 v" CLX_VERSION ", built " __DATE__ " " __TIME__ "\n");
+    ps4_boot_trace("clx: boot v" CLX_VERSION);
+    setenv("CLX_OPTIONS", CLX_DATA_DIR "/clx_options.txt", 0);
+    /* Console defaults, as on the Switch: the boot movie is skipped, single
+     * player is preselected, cutscenes skip on a press. */
+    setenv("CLX_SKIP_INTRO", "1", 0);
+    load_env();
+}
+
+void ps4_error_dialog(const char *msg)
+{
+    ps4_boot_tracef("clx: fatal: %s", msg);
+    fflush(stdout);
+    fflush(stderr);
+}
+
+void ps4_shutdown(void)
+{
+    printf("[ps4] exit\n");
+    ps4_boot_trace("clx: exit");
+    fflush(stdout);
+    fflush(stderr);
+}
+#endif
