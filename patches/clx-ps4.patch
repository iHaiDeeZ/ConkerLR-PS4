index 0000000..60f4789
--- /dev/null
+++ b/src/ps4_clx.c
@@ -0,0 +1,150 @@
+/*
+ * ps4_clx.c -- PS4 boot glue for the Conker recompilation (ps4-kit).
+ *
+ *   data      /data/ConkerLR: saves (save/), the renderer's shader and
+ *             pipeline caches, clx_options.txt, the log; the disc itself is
+ *             in the package (/app0/game, main.c)
+ *   logs      stdout and stderr go to /data/ConkerLR/clx_log.txt (the last
+ *             run's is kept as clx_log-prev.txt); ps4-kit writes crash.log
+ *             and boot-trace.log beside it
+ *   settings  /data/ConkerLR/clx_env.txt, KEY=VALUE per line, '#' comments,
+ *             read into the environment (a console has none) -- the same
+ *             file as the Switch's
+ *   crashes   ps4-kit's crash handler calls ps4_crash_guest_info, which adds
+ *             the guest's registers and stack to the log
+ */
+#ifdef __PS4__
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "ps4_kit_diag.h"
+
+#define CLX_DATA_DIR "/data/ConkerLR"
+
+PS4_DIAG_DATA_DIR(CLX_DATA_DIR);
+
+#ifndef CLX_VERSION
+#define CLX_VERSION "00.00"
+#endif
+
+void print_guest_state(void);
+
+/* ps4-kit's crash handler, after its own report: the guest's view. */
+void ps4_crash_guest_info(void)
+{
+    fprintf(stderr, "[CRASH] guest state:\n");
+    print_guest_state();
+}
+
+/* The renderers' weak per-present hook (the Switch's SaltyNX frame counter).
+ * create-fself refuses an eboot whose weak symbol nothing defines, so the PS4
+ * defines it, doing nothing. */
+void nv2a_host_frame_presented(unsigned int width, unsigned int height)
+{
+    (void)width;
+    (void)height;
+}
+
+/* SDL's audio thread asks for a high priority, which SDL's pthread back end
+ * cannot give on the PS4: the sound output's thread then waited behind the
+ * game's and the renderer's (crackles). HIGH and TIME_CRITICAL get 400, the
+ * priority ps4-kit keeps audio at (the game's threads run at 700). */
+int scePthreadSetprio(void *thread, int prio);
+void *scePthreadSelf(void);
+int __real_SDL_SYS_SetThreadPriority(int priority);
+
+int __wrap_SDL_SYS_SetThreadPriority(int priority)
+{
+    if (priority >= 2)                      /* SDL_THREAD_PRIORITY_HIGH */
+        return scePthreadSetprio(scePthreadSelf(), 400) == 0 ? 0 : -1;
+    return __real_SDL_SYS_SetThreadPriority(priority);
+}
+
+static void log_open(void)
+{
+    const char *path = CLX_DATA_DIR "/clx_log.txt";
+    int fd;
+
+    rename(path, CLX_DATA_DIR "/clx_log-prev.txt");
+    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) {
+        ps4_boot_tracef("clx: cannot open %s (errno %d)", path, errno);
+        return;
+    }
+    /* dup2, not freopen: the C library's freopen closes the stream for good. */
+    dup2(fd, 1);
+    dup2(fd, 2);
+    close(fd);
+}
+
+static void load_env(void)
+{
+    FILE *f = fopen(CLX_DATA_DIR "/clx_env.txt", "r");
+    char line[1024];
+
+    if (!f) {
+        printf("[ps4] no " CLX_DATA_DIR "/clx_env.txt: default settings\n");
+        return;
+    }
+    while (fgets(line, sizeof line, f)) {
+        char *eq, *end = line + strlen(line);
+        while (end > line && (end[-1] == '\n' || end[-1] == '\r' || end[-1] == ' '))
+            *--end = 0;
+        if (!line[0] || line[0] == '#' || !(eq = strchr(line, '=')) || eq == line)
+            continue;
+        *eq = 0;
+        setenv(line, eq + 1, 1);
+        printf("[ps4] env %s=%s\n", line, eq + 1);
+    }
+    fclose(f);
+}
+
+void ps4_boot(void)
+{
+    mkdir(CLX_DATA_DIR, 0777);
+    mkdir(CLX_DATA_DIR "/save", 0777);
+    log_open();
+    printf("[ps4] Conker: Live & Reloaded for PS4 v" CLX_VERSION ", built " __DATE__ " " __TIME__ "\n");
+    ps4_boot_trace("clx: boot v" CLX_VERSION);
+    setenv("CLX_OPTIONS", CLX_DATA_DIR "/clx_options.txt", 0);
+    /* Console defaults, as on the Switch: the boot movie is skipped, single
+     * player is preselected, cutscenes skip on a press. */
+    setenv("CLX_SKIP_INTRO", "1", 0);
+    /* The guest lock by guest priority, as the Switch's clx_env.txt has it: the
+     * game's time-critical sound mixer takes it from the main thread at once.
+     * FIFO (the default) kept the mixer waiting behind the main thread, worse
+     * at 60 fps: crackles and stutter (v00.04). RECOMP_GIL_EAGER=0 for FIFO. */
+    setenv("RECOMP_GIL_EAGER", "1", 0);
+    load_env();
+    /* With the [audio] line (RECOMP_AUDIO_LOG): the voice processor's clicks
+     * every 10 s too -- stale ring samples, starved streams, frame-boundary
+     * jumps per voice. */
+    if (!(getenv("RECOMP_AUDIO_LOG") && getenv("RECOMP_AUDIO_LOG")[0] == '0')) {
+        setenv("RECOMP_APU_RING_STATS", "1", 0);
+        /* (RECOMP_APU_VOICES=1: every voice heard in each 5 s with the guest's
+         * on/release/off/pause methods; RECOMP_APU_SEGLOG=1: stream packets
+         * played vs. bank reads by checksum -- how the rain was found, v00.08.
+         * Both in clx_env.txt when needed.) */
+    }
+}
+
+void ps4_error_dialog(const char *msg)
+{
+    ps4_boot_tracef("clx: fatal: %s", msg);
+    fflush(stdout);
+    fflush(stderr);
+}
+
+void ps4_shutdown(void)
+{
+    printf("[ps4] exit\n");
+    ps4_boot_trace("clx: exit");
+    fflush(stdout);
+    fflush(stderr);
+}
+#endif
