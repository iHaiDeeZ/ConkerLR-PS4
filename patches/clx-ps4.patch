+LPVOID MapViewOfFileEx(HANDLE mapping, DWORD access, DWORD offHigh, DWORD offLow,
+                       SIZE_T count, LPVOID baseAddr)
+{
+    w32_object *o = obj_from(mapping);
+    size_t off = ((size_t)offHigh << 32) | offLow, len;
+    uintptr_t at, p;
+
+    (void)access;
+    if (!o || o->kind != K_FILEMAP) { SetLastError(ERROR_INVALID_HANDLE); return NULL; }
+    if ((off & (PS4_PAGE - 1)) || off >= o->map_size) { SetLastError(ERROR_INVALID_PARAMETER); return NULL; }
+    len = ps4_page(count ? count : o->map_size - off);
+    if (off + len > ps4_page(o->map_size)) { SetLastError(ERROR_INVALID_PARAMETER); return NULL; }
+    pthread_mutex_lock(&s_ps4_lock);
+    if (baseAddr) {
+        at = (uintptr_t)baseAddr;
+        if ((at & (PS4_PAGE - 1)) || !ps4_in_win(at, len)) {
+            pthread_mutex_unlock(&s_ps4_lock);
+            fprintf(stderr, "  [PS4] view at %p (+%zu KB): not a host page in the guest window\n",
+                    baseAddr, len / 1024);
+            SetLastError(ERROR_INVALID_ADDRESS);
+            return NULL;
+        }
+        /* Win32 refuses an address that is taken; MAP_FIXED would replace it. */
+        for (p = at; p < at + len; p += PS4_PAGE)
+            if (ps4_backed(p)) {
+                pthread_mutex_unlock(&s_ps4_lock);
+                fprintf(stderr, "  [PS4] view at %p (+%zu KB): %p is taken\n", baseAddr, len / 1024,
+                        (void *)p);
+                SetLastError(ERROR_INVALID_ADDRESS);
+                return NULL;
+            }
+    } else {
+        void *a = NULL;
+        if (sceKernelReserveVirtualRange(&a, len, 0, 2u << 20)) {
+            pthread_mutex_unlock(&s_ps4_lock);
+            SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+            return NULL;
+        }
+        at = (uintptr_t)a;
+    }
+    if (o->fd >= 0) {
+        void *v = mmap((void *)at, len, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, o->fd, (off_t)off);
+        if (v != (void *)at) {
+            pthread_mutex_unlock(&s_ps4_lock);
+            fprintf(stderr, "  [PS4] shared-memory view at %p (+%zu KB) failed (errno %d)\n",
+                    (void *)at, len / 1024, errno);
+            SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+            return NULL;
+        }
+    } else if (!ps4_map_phys(at, len, o->ps4_phys + (off_t)off)) {
+        pthread_mutex_unlock(&s_ps4_lock);
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return NULL;
+    }
+    if (ps4_in_win(at, len))
+        ps4_mark(at, len, 1);
+    ps4_add(at, len, o->fd >= 0 ? -1 : o->ps4_phys + (off_t)off, 0, 0);
+    view_register((void *)at, len);
+    pthread_mutex_unlock(&s_ps4_lock);
+    return (LPVOID)at;
+}
+
+LPVOID MapViewOfFile(HANDLE mapping, DWORD access, DWORD offHigh, DWORD offLow, SIZE_T count)
+{
+    return MapViewOfFileEx(mapping, access, offHigh, offLow, count, NULL);
+}
