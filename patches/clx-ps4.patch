+#elif defined(__PS4__)
+/* File mappings on the PS4: a POSIX shared-memory object per mapping, mapped
+ * again for every view -- see "Virtual memory on the PS4" above. Direct memory
+ * cannot alias (a second sceKernelMapDirectMemory of the same pages fails with
+ * 0x80020010, v00.01 on the console), so it is only the fallback when there is
+ * no shared memory, and then a mapping has one view. */
+static int ps4_shm(size_t size)
+{
+    static volatile LONG seq;
+    char name[32];
+    int fd;
+
+    snprintf(name, sizeof name, "/clx_map_%ld", (long)InterlockedIncrement(&seq));
+    fd = shm_open(name, O_CREAT | O_EXCL | O_RDWR, 0600);
+    if (fd < 0)
+        return -1;
+    shm_unlink(name);
+    if (ftruncate(fd, (off_t)size) != 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+HANDLE CreateFileMappingA(HANDLE file, LPSECURITY_ATTRIBUTES sa, DWORD protect,
+                          DWORD maxSizeHigh, DWORD maxSizeLow, LPCSTR name)
+{
+    SIZE_T size = ((SIZE_T)maxSizeHigh << 32) | maxSizeLow;
+    off_t phys;
+    w32_object *o;
+    int fd;
+
+    (void)file; (void)sa; (void)protect; (void)name;
+    if (!size) { SetLastError(ERROR_INVALID_PARAMETER); return NULL; }
+    fd = ps4_shm(ps4_page(size));
+    fprintf(stderr, "  [PS4] file mapping of %zu KB: %s\n", (size_t)size / 1024,
+            fd >= 0 ? "shared memory (views alias)" : "direct memory (one view)");
+    if (fd >= 0) {                          /* zero-filled by the kernel */
+        o = obj_alloc(K_FILEMAP);
+        o->fd       = fd;
+        o->ps4_phys = -1;
+        o->map_size = size;
+        return (HANDLE)o;
+    }
+    phys = ps4_alloc_direct(ps4_page(size));
+    if (phys < 0) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+    {                                       /* direct memory comes back as it was left */
+        void *a = NULL;
+        if (sceKernelReserveVirtualRange(&a, ps4_page(size), 0, PS4_PAGE) == 0) {
+            if (ps4_map_phys((uintptr_t)a, ps4_page(size), phys))
+                memset(a, 0, ps4_page(size));
+            sceKernelMunmap(a, ps4_page(size));
+        }
+    }
+    o = obj_alloc(K_FILEMAP);
+    o->fd       = -1;
+    o->ps4_phys = phys;
+    o->map_size = size;
+    return (HANDLE)o;
+}
